#include <stdio.h>

int main () {
    int numero;
    int menu;

    // Exibe as opções disponíveis e lê a escolha do usuário
    printf ("===== MENU =====\n 1 - Verificar número par ou ímpar\n 2 - Verificar se é positivo ou negativo\n 3 - Calcular o quadrado do número\n 4 – Sair\n");
    printf ("Escolha uma opção:\n");
    scanf ("%d", &menu);

    // Seleciona a operação com base na opção digitada
    switch (menu) {

        // Avalia a paridade do número usando o operador de resto (%)
        case 1:
            printf ("Digite um número:\n");
            scanf ("%d", &numero);
            if (numero % 2 == 0) {
                printf ("O número %d é par\n", numero);
            }
            else {
                printf ("O número é impar\n");
            }

            break;

        // Checa o sinal do número (positivo, zero ou negativo)
        case 2: 
            printf ("Digite um número: \n");
            scanf ("%d", &numero);
            if (numero > 0) {
                printf ("O número é positivo\n");
            }

            else if (numero == 0) {
                printf ("O número é zero\n");
            }

            else {
                printf ("O número é negativo\n");
            }

            break;

        // Realiza o cálculo de potenciação (número multiplicado por ele mesmo)
        case 3:
            printf ("Digite um número: \n");
            scanf ("%d", &numero);
            printf ("O quadrado do número é %d\n", (numero * numero));

            break;

        // Finaliza a execução do programa
        case 4:
            printf ("Você saiu do programa\n");
            
            break;

        // Trata opções digitadas fora do intervalo de 1 a 4
        default:
            printf ("Opção inválida\n");
            break;
    }

    return 0;
}
