#include <stdio.h>
int main () {
    int numero;
    int menu;

    // Exibe a lista de opções e lê a escolha do usuário
    printf ("===== MENU =====\n 1 - Verificar número par ou ímpar\n 2 - Verificar se é positivo ou negativo\n 3 - Calcular o quadrado do número\n 4 – Sair\n");
    printf ("Escolha uma opção:\n");
    scanf ("%d", &menu);

    // Estrutura que executa o bloco de código correspondente à opção escolhida
    switch (menu) {

        // Verifica a paridade dividindo por 2 e checando o resto
        case 1:
            printf ("Digite um número:\n");
            scanf ("%d", &numero);
            if (numero % 2 == 0) {
                printf ("O número %d é par\n", numero);
            }
            else {
                printf ("O número é impar\n");
            }

            break;

        // Compara o número com zero para saber se é positivo, nulo ou negativo
        case 2: 
            printf ("Digite um número: \n");
            scanf ("%d", &numero);
            if (numero > 0) {
                printf ("O número é positivo\n");
            }

            else if (numero == 0) {
                printf ("O número é zero\n");
            }

            else {
                printf ("O número é negativo\n");
            }

            break;

        // Multiplica o número por ele mesmo para obter o quadrado
        case 3:
            printf ("Digite um número: \n");
            scanf ("%d", &numero);
            printf ("O quadrado do número é %d", (numero * numero));

            break;

        // Opção para encerrar o programa
        case 4:
            printf ("Você saiu do programa\n");
            
            break;

        // Trata qualquer opção digitada que não seja de 1 a 4
        default:
            printf ("Opção inválida");
            break;
    }

    return 0;

}
