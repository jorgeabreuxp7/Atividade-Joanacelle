#include <stdio.h>

int main () {
    int maior;
    int lado1;
    int lado2;
    int a;
    int b;
    int c;
    printf ("Digite o 1 lado do triangulo\n");
    scanf ("%d", &a);
    printf ("Digite o 2 lado do triangulo\n");
    scanf ("%d", &b);
    printf ("Digite o 3 lado do triangulo\n");
    scanf ("%d", &c);

// SE PODE FORMAR O TRIANGULO

    if (a + b > c && a + c > b && b + c > a) {
        printf ("É possível formar um triangulo:\n");

// MAIOR LADO DO TRIANGULO

        if (a >= b && a >= c) {
            maior = a;
            lado1 = b;
            lado2 = c;
        }
        else if (b >= a && b >= c) {
            maior = b;
            lado1 = a;
            lado2 = c;
        }
        else {
            maior = c;
            lado1 = a;
            lado2 = b;
        }

// CLASSIFICAR QUAL TIPO DE TRIANGULO É

        if (a == b && a == c) {
            printf ("O triângulo é equilátero\n");
        }
        else if (a == b || a == c || b == c) {
            printf ("O triangulo é isosceles\n");
        }
        else {
            printf ("O triangulo é escaleno\n");
        }

// DETERMINAÇÃO DO ÂNGULO DO TRIÂNGULO

        if ((maior * maior) > (lado1 * lado1) + (lado2 * lado2)) {
            printf ("O triângulo é obtusangulo\n");
        }
        else if ((maior * maior) == (lado1 * lado1) + (lado2 * lado2)) {
            printf ("O triangulo é retângulo\n");
        }
        else {
            printf ("O triangulo é acutangulo\n");
        }
    }
    else {
        printf ("Não é possível formar um triângulo\n");
    }
    return 0;
}