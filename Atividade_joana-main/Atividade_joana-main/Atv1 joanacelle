#include <stdio.h>

int main () {
    int maior;
    int lado1;
    int lado2;
    int a;
    int b;
    int c;

    // Coleta as medidas dos três lados informados pelo usuário
    printf ("Digite o 1 lado do triangulo\n");
    scanf ("%d", &a);
    printf ("Digite o 2 lado do triangulo\n");
    scanf ("%d", &b);
    printf ("Digite o 3 lado do triangulo\n");
    scanf ("%d", &c);

    // Valida a condição de existência: a soma de dois lados deve ser sempre maior que o terceiro
    if (a + b > c && a + c > b && b + c > a) {
        printf ("É possível formar um triangulo:\n");

        // Descobre qual é o maior lado e guarda os outros dois nas variáveis auxiliares
        if (a >= b && a >= c) {
            maior = a;
            lado1 = b;
            lado2 = c;
        }
        else if (b >= a && b >= c) {
            maior = b;
            lado1 = a;
            lado2 = c;
        }
        else {
            maior = c;
            lado1 = a;
            lado2 = b;
        }

        // Analisa a igualdade dos lados (3 iguais, 2 iguais ou todos diferentes)
        if (a == b && a == c) {
            printf ("O triângulo é equilátero\n");
        }
        else if (a == b || a == c || b == c) {
            printf ("O triangulo é isosceles\n");
        }
        else {
            printf ("O triangulo é escaleno\n");
        }

        // Classifica os ângulos aplicando a relação entre o quadrado do maior lado e a soma dos quadrados dos outros dois
        if ((maior * maior) > (lado1 * lado1) + (lado2 * lado2)) {
            printf ("O triângulo é obtusangulo\n");
        }
        else if ((maior * maior) == (lado1 * lado1) + (lado2 * lado2)) {
            printf ("O triangulo é retângulo\n");
        }
        else {
            printf ("O triangulo é acutangulo\n");
        }
    }
    // Mensagem de erro caso os valores informados não satisfaçam a condição de existência
    else {
        printf ("Não é possível formar um triângulo\n");
    }
    return 0;
}
