    printf("Digite o 2º número: ");
    scanf("%d", &b);
    printf("Digite o 3º número: ");
    scanf("%d", &c);

    // NÚMEROS NÃO REPETIDOS

    if (a != b && a != c && b != c) {
        printf("Não existem números repetidos\n");
        
        // MAIOR NÚMERO

        if (a > b && a > c) {
            printf("O número %d é o maior número\n", a);
        }
        else if (b > a && b > c) {
