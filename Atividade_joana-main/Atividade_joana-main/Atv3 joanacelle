#include <stdio.h>

int main() {
    int a;
    int b;
    int c;

    // Recebe os três números digitados pelo usuário
    printf("Digite o 1º número: ");
    scanf("%d", &a);
    printf("Digite o 2º número: ");
    scanf("%d", &b);
    printf("Digite o 3º número: ");
    scanf("%d", &c);

    // Entra aqui apenas se todos os números forem diferentes entre si
    if (a != b && a != c && b != c) {
        printf("Não existem números repetidos\n");
        
        // Compara os valores para descobrir qual deles é o maior
        if (a > b && a > c) {
            printf("O número %d é o maior número\n", a);
        }
        else if (b > a && b > c) {
            printf("O número %d é o maior número\n", b);
        }
        else {
            printf("O número %d é o maior número\n", c);
        }

        // Compara os valores para descobrir qual deles é o menor
        if (a < b && a < c) {
            printf("O menor número é %d\n", a);
        }
        else if (b < a && b < c) {
            printf("O menor número é %d\n", b);
        }
        else {
            printf("O menor número é %d\n", c);
        }

        // Verifica qual número ficou no meio dos outros dois
        if ((a > b && a < c) || (a > c && a < b)) {
            printf("O número intermediário é %d\n", a);
        }
        else if ((b > a && b < c) || (b > c && b < a)) {
            printf("O número intermediário é %d\n", b);
        }
        else {
            printf("O número intermediário é %d\n", c);
        }

        // Checa as combinações de ordem em que os números foram inseridos
        if (a < b && b < c) {
            printf("Ordem crescente\n");
        }
        else if (a > b && b > c) {
            printf("Ordem decrescente\n");
        }
        else if (a < c && c < b) {
            printf("Fora de ordem\n");
        }
        else if (a > c && c > b) {
            printf("Fora de ordem\n");
        }
        else if (b < a && a < c) {
            printf("Fora de ordem\n");
        }
        else if (b > a && a > c) {
            printf("Fora de ordem\n");
        }
        else if (b < c && c < a) {
            printf("Fora de ordem\n");
        }
        else if (b > c && c > a) {
            printf("Fora de ordem\n");
        }
        else if (c < a && a < b) {
            printf("Fora de ordem\n");
        }
        else if (c > a && a > b) {
            printf("Fora de ordem\n");
        }
        else {
            printf("Sem ordem\n");
        }
    }

    // Caso onde os três valores inseridos são idênticos
    else if (a == b && a == c) {
        printf("Todos os números são iguais\n");
    }
    
    // Caso padrão para quando existirem apenas dois números iguais
    else {
        printf("Existem números repetidos\n");
    }

    return 0;
}
